<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Packages come from nuget.org alone, whatever else a machine is set up with -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!-- Ignore machine-wide fallback package folders, such as one a Visual Studio install points at a drive that isn't there -->
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
